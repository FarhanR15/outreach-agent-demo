# Copy to .env and fill in the four API keys. Everything else has a working default.
# .env is gitignored and Claude never reads or writes it — you manage this file.

# ─── Required: API keys ───────────────────────────────────────────────────────────

# Apollo.io — the key's scope must include BOTH of these endpoints (or use a master key):
#   api/v1/mixed_people/api_search   (search — free, 0 credits)
#   api/v1/people/bulk_match         (enrichment — ~1 credit/lead)
# Search alone returns no emails or LinkedIn URLs, so enrichment is required.
APOLLO_API_KEY=

# Apify — verification, deep research, and email discovery
APIFY_TOKEN=

# OpenRouter — powers all three model roles below
OPENROUTER_API_KEY=

# Instantly — campaign creation + lead upload (v2 API)
INSTANTLY_API_KEY=


# ─── Optional: everything below has a sensible default ────────────────────────────

# Apify actors. Defaults verified 2026-08-20 on apify.com/store, pay-per-event.
#   linkedin: $4/1k profiles, $10/1k when it also hunts a missing email
#   posts:    recent posts are what make an opener sound like a human actually looked.
#             Set to empty to skip (cheaper, noticeably worse openers).
#   company:  crawls up to 3 pages of their site
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-profile-scraper
APIFY_POSTS_ACTOR=harvestapi/linkedin-profile-posts
APIFY_COMPANY_ACTOR=apify/website-content-crawler

# The three model roles. Slugs verified to exist on OpenRouter 2026-08-20; prices per 1M
# tokens. Deliberately three different vendors so the critic doesn't share the writer's
# blind spots. Roughly $8.60 per 1,000 leads all-in at these settings.
#   qualifier — judges ICP fit, runs on every lead, so cheap matters   $0.20 / $1.20
#   writer    — the only output a stranger reads, so quality matters   $2.00 / $10.00
#   critic    — independently checks the writer for fabrication        $0.375 / $1.875
# Cheaper swap: qualifier→nvidia/nemotron-3.5-lightning, writer→anthropic/claude-haiku-4.5
# brings it to roughly $4.10 per 1,000.
OPENROUTER_QUALIFIER_MODEL=openai/gpt-5.6-luna
OPENROUTER_WRITER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_CRITIC_MODEL=google/gemini-3.7-flash

# Which mailboxes send. Leave BLANK to auto-discover every healthy, active, non-banned
# mailbox in your Instantly workspace (recommended — it adapts as you add mailboxes).
# Set a comma-separated list to pin specific ones.
INSTANTLY_SENDING_EMAILS=
